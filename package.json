{
  "name": "arcline-epd-digest",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "probe": "tsx --env-file=.env.local scripts/probe-workspace.ts",
    "bootstrap": "tsx scripts/bootstrap-workspace.ts",
    "patch": "tsx scripts/patch-schema.ts",
    "typecheck": "tsc --noEmit",
    "validate-fixtures": "tsx scripts/validate-fixtures.ts",
    "workers":   "tsx --env-file=.env.local scripts/trigger-workers.ts",
    "seed-week": "tsx --env-file=.env.local scripts/seed-week.ts",
    "hitl-review": "tsx scripts/hitl-review.ts",
    "observe": "tsx scripts/setup-observability.ts",
    "summarizer:deploy": "pnpm --filter arcline-worker-summarizer deploy",
    "summarizer-product:deploy": "pnpm --filter arcline-worker-summarizer-product deploy",
    "summarizer-squad:deploy": "pnpm --filter arcline-worker-summarizer-squad deploy",
    "summarizer-master:deploy": "pnpm --filter arcline-worker-summarizer-master deploy",
    "product-summarizers": "tsx scripts/trigger-product-summarizers.ts",
    "master-summarizer": "tsx scripts/trigger-master-summarizer.ts",
    "reset-data":         "tsx --env-file=.env.local scripts/reset-data.ts",
    "demo-week":          "tsx --env-file=.env.local scripts/demo-week.ts",
    "generate-summaries": "tsx --env-file=.env.local scripts/generate-summaries.ts",
    "approve-week":       "tsx --env-file=.env.local scripts/approve-week.ts",
    "generate-master":    "tsx --env-file=.env.local scripts/generate-master.ts",
    "eval": "tsx --env-file=.env.local evals/run.ts",
    "eval:golden": "tsx --env-file=.env.local evals/golden-replay.ts",
    "patch-round2":        "tsx --env-file=.env.local scripts/patch-schema-round2.ts",
    "seed-gtm-fixtures":   "tsx --env-file=.env.local scripts/seed-gtm-fixtures.ts",
    "gtm-daily-digest":    "tsx --env-file=.env.local scripts/trigger-gtm-daily-digest.ts",
    "gtm-meeting-summarizer:deploy": "pnpm --filter arcline-worker-gtm-meeting-summarizer deploy"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@notionhq/client": "^2.3.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
