{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arcline.internal/fixtures/schemas/slack",
  "title": "Slack fixture file",
  "description": "Array of SourceRecord entries for source=slack. Each entry represents one thread.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["sourceId", "source", "squadId", "title", "url", "lastUpdated", "raw"],
    "additionalProperties": false,
    "properties": {
      "sourceId": {
        "type": "string",
        "description": "Stable identifier for the thread, e.g. 'lumen-slack-C02-001'"
      },
      "source": {
        "type": "string",
        "const": "slack"
      },
      "squadId": {
        "type": "string",
        "enum": ["atlas", "lumen", "forge"]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "lastUpdated": {
        "type": "string",
        "format": "date-time"
      },
      "summary": {
        "type": "string"
      },
      "raw": {
        "type": "object",
        "required": ["channel", "thread_ts", "participant_count", "messages"],
        "properties": {
          "channel": { "type": "string" },
          "thread_ts": { "type": "string" },
          "participant_count": { "type": "integer", "minimum": 1 },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["author", "text", "ts"],
              "properties": {
                "author": { "type": "string" },
                "text": { "type": "string" },
                "ts": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
