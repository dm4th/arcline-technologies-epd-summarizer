{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arcline.internal/fixtures/schemas/github",
  "title": "GitHub fixture file",
  "description": "Array of SourceRecord entries for source=github. Each entry represents one pull request.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["sourceId", "source", "squadId", "title", "url", "lastUpdated", "raw"],
    "additionalProperties": false,
    "properties": {
      "sourceId": {
        "type": "string",
        "description": "Stable identifier in source system, e.g. 'atlas-pr-048'"
      },
      "source": {
        "type": "string",
        "const": "github"
      },
      "squadId": {
        "type": "string",
        "enum": ["atlas", "lumen", "forge"]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "lastUpdated": {
        "type": "string",
        "format": "date-time"
      },
      "summary": {
        "type": "string"
      },
      "raw": {
        "type": "object",
        "required": ["number", "state", "merged", "author", "base_branch", "head_branch", "changed_files", "additions", "deletions"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "state": { "type": "string", "enum": ["open", "merged", "closed"] },
          "merged": { "type": "boolean" },
          "merged_at": { "type": ["string", "null"], "format": "date-time" },
          "author": { "type": "string" },
          "body": { "type": "string" },
          "linked_jira_key": { "type": ["string", "null"] },
          "base_branch": { "type": "string" },
          "head_branch": { "type": "string" },
          "changed_files": { "type": "integer", "minimum": 0 },
          "additions": { "type": "integer", "minimum": 0 },
          "deletions": { "type": "integer", "minimum": 0 },
          "reviewers": { "type": "array", "items": { "type": "string" } },
          "labels": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
