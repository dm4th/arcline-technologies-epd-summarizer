{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arcline.internal/fixtures/schemas/jira",
  "title": "Jira fixture file",
  "description": "Array of SourceRecord entries for source=jira. Each entry represents one ticket.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["sourceId", "source", "squadId", "title", "url", "lastUpdated", "raw"],
    "additionalProperties": false,
    "properties": {
      "sourceId": {
        "type": "string",
        "description": "Stable Jira ticket key, e.g. 'ATLS-42'"
      },
      "source": {
        "type": "string",
        "const": "jira"
      },
      "squadId": {
        "type": "string",
        "enum": ["atlas", "lumen", "forge"]
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "url": {
        "type": "string",
        "format": "uri"
      },
      "lastUpdated": {
        "type": "string",
        "format": "date-time"
      },
      "summary": {
        "type": "string"
      },
      "raw": {
        "type": "object",
        "required": ["key", "status", "type", "priority"],
        "properties": {
          "key": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["To Do", "In Progress", "In Review", "Done", "Backlog", "Blocked"]
          },
          "assignee": { "type": ["string", "null"] },
          "type": {
            "type": "string",
            "enum": ["Story", "Bug", "Task", "Epic", "Spike", "Sub-task"]
          },
          "priority": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "story_points": { "type": ["number", "null"] },
          "sprint": { "type": ["string", "null"] },
          "acceptance_criteria": { "type": ["string", "null"] },
          "labels": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  }
}
